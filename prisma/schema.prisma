generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Institution {
  id        String   @id @default(cuid())
  name      String
  branding  String?
  users     User[]
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                      String                  @id @default(cuid())
  name                    String
  email                   String                  @unique
  passwordHash            String?
  avatar                  String?
  role                    String
  institutionId           String
  institution             Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  ownedCourses            Course[]                @relation("CourseOwner")
  courseCollaborations    CourseCollaborator[]
  enrollments             CourseEnrollment[]
  importBatches           DocumentImportBatch[]
  importJobs              DocumentImportJob[]
  sentMessages            Message[]               @relation("SentMessages")
  receivedMessages        Message[]               @relation("ReceivedMessages")
  groupMembers            GroupMember[]
  groupPosts              GroupPost[]
  groupComments           GroupComment[]
  groupFiles              GroupFile[]
  notes                   Note[]
  noteTags                NoteTag[]
  courseAiArtifacts       CourseAiArtifact[]
  courseQuestions         CourseQuestion[]
  aiConversations         CourseAiConversation[]
  copilotSkills           CopilotSkill[]          @relation("CopilotSkillUploader")
  copilotUsageEvents      CopilotUsageEvent[]
  topicFolders            TopicFolder[]
  topics                  Topic[]
  driveFiles              DriveFile[]
  driveShares             DriveShare[]
  driveShareGrants        DriveShareGrant[]
  plagiarismChecks        PlagiarismCheck[]
  liveSessions            LiveSession[]           @relation("LiveHost")
  liveParticipants        LiveParticipant[]
  liveChatMessages        LiveChatMessage[]
  announcements           Announcement[]
  announcementReads       AnnouncementRead[]
  driveFileDownloads      DriveFileDownload[]     @relation("DriveFileDownloadUser")
  attendanceSessions      AttendanceSession[]     @relation("AttendanceCreator")
  attendanceRecords       AttendanceRecord[]      @relation("AttendanceStudent")
  lessonProgress          LessonProgress[]
  createdAssignments      Assignment[]            @relation("AssignmentCreator")
  assignmentSubmissions   AssignmentSubmission[]
  assignmentExtensions    AssignmentExtension[]
  createdExams            Exam[]                  @relation("ExamCreator")
  examAttempts            ExamAttempt[]
  helpTickets             HelpTicket[]
  createdAuditLogs        AuditLog[]
  updatedDriveAccessRules CourseDriveAccessRule[] @relation("CourseDriveAccessRuleUpdater")
  creditAccount           CreditAccount?
  paymentOrders           PaymentOrder[]
  imageGenerationBatches  ImageGenerationBatch[]
  onboardingState         String?
  onboardingVersion       Int                     @default(0)
  onboardingStep          Int                     @default(0)
  onboardingCourseId      String?
  onboardingPromptCount   Int                     @default(0)
  onboardingLastPromptAt  DateTime?
  onboardingLastSessionId String?
  onboardingCompletedAt   DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

model Course {
  id                 String                  @id @default(cuid())
  title              String
  description        String?
  cover              String?
  term               String?
  startDate          DateTime?
  endDate            DateTime?
  status             String                  @default("ACTIVE")
  ownerId            String
  owner              User                    @relation("CourseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  institutionId      String
  institution        Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  driveRootFolderId  String?                 @unique
  driveRootFolder    DriveFile?              @relation("CourseDriveRoot", fields: [driveRootFolderId], references: [id], onDelete: SetNull)
  copilotName        String                  @default("课程AI智能体")
  outlineVersion     Int                     @default(0)
  collaborators      CourseCollaborator[]
  enrollments        CourseEnrollment[]
  chapters           Chapter[]
  resources          Resource[]
  imports            DocumentImportJob[]
  importBatches      DocumentImportBatch[]
  aiArtifacts        CourseAiArtifact[]
  questions          CourseQuestion[]
  aiConversations    CourseAiConversation[]
  copilotSkills      CopilotSkill[]
  copilotUsageEvents CopilotUsageEvent[]
  knowledgeMaps      CourseKnowledgeMap[]
  announcements      Announcement[]
  attendanceSessions AttendanceSession[]
  assignments        Assignment[]
  exams              Exam[]
  helpTickets        HelpTicket[]
  notes              Note[]
  driveBindings      CourseDriveBinding[]
  driveAccessRules   CourseDriveAccessRule[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
}

model CourseCollaborator {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MANAGER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, userId])
  @@index([userId, updatedAt])
}

model CourseEnrollment {
  id          String    @id @default(cuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([courseId, userId])
}

model Chapter {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  summary   String?
  order     Int
  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  id                 String           @id @default(cuid())
  chapterId          String
  chapter            Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title              String
  summary            String?
  order              Int
  estimatedMinutes   Int?
  taskPointCompleted Boolean          @default(false)
  keyPoints          String?
  activities         String?
  assessments        String?
  resources          Resource[]
  notes              Note[]
  progress           LessonProgress[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Resource {
  id          String     @id @default(cuid())
  courseId    String
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId    String?
  lesson      Lesson?    @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title       String
  type        String
  url         String?
  driveFileId String?
  driveFile   DriveFile? @relation(fields: [driveFileId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model DocumentImportJob {
  id               String               @id @default(cuid())
  courseId         String
  course           Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           String               @default("QUEUED")
  originalName     String
  filePath         String?
  fileSize         Int                  @default(0)
  mimeType         String?
  driveFileId      String?
  driveFile        DriveFile?           @relation("ImportSourceDriveFile", fields: [driveFileId], references: [id], onDelete: SetNull)
  batchId          String?
  batch            DocumentImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  contentHash      String?
  extractedText    String?
  parsedSections   String?
  generatedOutline String?
  warning          String?
  errorMessage     String?
  currentStage     String?
  retryCount       Int                  @default(0)
  startedAt        DateTime?
  finishedAt       DateTime?
  deletedAt        DateTime?
  knowledgeMaps    CourseKnowledgeMap[]
  aiArtifacts      CourseAiArtifact[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([batchId, createdAt])
  @@index([courseId, contentHash])
  @@index([courseId, deletedAt, createdAt])
}

model DocumentImportBatch {
  id                      String              @id @default(cuid())
  courseId                String
  course                  Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId                  String
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                  String              @default("QUEUED")
  generatedOutline        String?
  generatedOutlineVersion Int                 @default(0)
  savedOutlineVersion     Int?
  savedAt                 DateTime?
  documents               DocumentImportJob[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([courseId, createdAt])
  @@index([userId, createdAt])
}

model CourseAiArtifact {
  id               String                   @id @default(cuid())
  seriesId         String                   @default(cuid())
  courseId         String
  course           Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId           String
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appType          String
  title            String
  prompt           String?
  payload          String?
  inputSnapshot    String?
  runToken         String?
  scope            String?
  status           String                   @default("DRAFT")
  version          Int                      @default(1)
  errorCode        String?
  errorMessage     String?
  sourceJobId      String?
  sourceJob        DocumentImportJob?       @relation(fields: [sourceJobId], references: [id], onDelete: SetNull)
  sourceArtifactId String?
  sourceArtifact   CourseAiArtifact?        @relation("ArtifactRevisionSource", fields: [sourceArtifactId], references: [id], onDelete: SetNull)
  derivedArtifacts CourseAiArtifact[]       @relation("ArtifactRevisionSource")
  questions        CourseQuestion[]
  startedAt        DateTime?
  finishedAt       DateTime?
  approvedAt       DateTime?
  publishedAt      DateTime?
  publishedPayload String?
  withdrawnAt      DateTime?
  deletedAt        DateTime?
  lockVersion      Int                      @default(0)
  exports          CourseAiArtifactExport[]
  imageBatch       ImageGenerationBatch?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([seriesId, version])
  @@index([courseId, appType, status])
  @@index([status, createdAt])
  @@index([status, runToken])
  @@index([sourceArtifactId])
}

model CreditAccount {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  available Int            @default(0)
  reserved  Int            @default(0)
  version   Int            @default(0)
  ledgers   CreditLedger[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model CreditLedger {
  id             String        @id @default(cuid())
  accountId      String
  account        CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type           String
  availableDelta Int           @default(0)
  reservedDelta  Int           @default(0)
  referenceType  String
  referenceId    String
  description    String?
  metadata       String?
  createdAt      DateTime      @default(now())

  @@unique([referenceType, referenceId, type])
  @@index([accountId, createdAt])
}

model PaymentOrder {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  outTradeNo     String         @unique
  idempotencyKey String
  planId         String
  planName       String
  planCredits    Int
  planBaseCredits Int
  planBonusCredits Int @default(0)
  amountFen      Int
  provider       String
  status         String         @default("CREATED")
  providerTradeNo String?
  paymentPayload String?
  expiresAt      DateTime
  paidAt         DateTime?
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  events         PaymentEvent[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

model PaymentEvent {
  id             String        @id @default(cuid())
  orderId        String?
  order          PaymentOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  provider       String
  providerEventId String
  verified       Boolean       @default(false)
  payload        String
  createdAt      DateTime      @default(now())

  @@unique([provider, providerEventId])
  @@index([orderId, createdAt])
}

model ImageGenerationBatch {
  id           String                @id @default(cuid())
  artifactId   String                @unique
  artifact     CourseAiArtifact      @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedPages Int
  status       String                @default("QUEUED")
  pages        ImageGenerationPage[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ImageGenerationPage {
  id            String               @id @default(cuid())
  batchId       String
  batch         ImageGenerationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  pageNo        Int
  title         String
  content       String
  prompt        String
  status        String               @default("QUEUED")
  providerTaskId String?
  imagePath     String?
  errorCode     String?
  errorMessage  String?
  creditReferenceId String             @unique
  consumedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([batchId, pageNo])
  @@index([batchId, status, pageNo])
}

model CourseQuestion {
  id               String            @id @default(cuid())
  courseId         String
  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdById      String?
  createdBy        User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sourceArtifactId String?
  sourceArtifact   CourseAiArtifact? @relation(fields: [sourceArtifactId], references: [id], onDelete: SetNull)
  sourceSeriesId   String
  sourceKey        String
  type             String
  stem             String
  options          String?
  answer           String
  explanation      String
  status           String            @default("DRAFT")
  version          Int               @default(1)
  approvedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([courseId, sourceSeriesId, sourceKey])
  @@index([courseId, status, type])
  @@index([sourceArtifactId])
}

model CourseAiConversation {
  id              String                    @id @default(cuid())
  courseId        String
  course          Course                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId          String
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            String
  status          String                    @default("ACTIVE")
  generationToken String?
  title           String?
  activeSkillId   String?
  activeSkill     CopilotSkill?             @relation("CopilotActiveSkill", fields: [activeSkillId], references: [id], onDelete: SetNull)
  messages        CourseAiMessage[]
  attachments     CopilotConversationFile[]
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([courseId, userId, kind, updatedAt])
  @@index([activeSkillId, updatedAt])
  @@index([status, generationToken])
}

model CourseAiMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   CourseAiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  citations      String?
  skillId        String?
  skill          CopilotSkill?        @relation("CopilotMessageSkill", fields: [skillId], references: [id], onDelete: SetNull)
  skillName      String?
  contextFiles   String?
  createdAt      DateTime             @default(now())

  @@index([conversationId, createdAt])
  @@index([skillId, createdAt])
}

model CopilotSkill {
  id                  String                 @id @default(cuid())
  courseId            String
  course              Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedById        String
  uploadedBy          User                   @relation("CopilotSkillUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  name                String
  description         String
  instructions        String
  originalName        String
  fileSize            Int
  status              String                 @default("DISABLED")
  activeConversations CourseAiConversation[] @relation("CopilotActiveSkill")
  messages            CourseAiMessage[]      @relation("CopilotMessageSkill")
  usageEvents         CopilotUsageEvent[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([courseId, status, updatedAt])
  @@index([uploadedById, updatedAt])
}

model CopilotConversationFile {
  id             String               @id @default(cuid())
  conversationId String
  conversation   CourseAiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  driveFileId    String?
  driveFile      DriveFile?           @relation(fields: [driveFileId], references: [id], onDelete: SetNull)
  fileName       String
  mimeType       String?
  referenceType  String               @default("FILE")
  createdAt      DateTime             @default(now())

  @@unique([conversationId, driveFileId])
  @@index([driveFileId, createdAt])
}

model CopilotUsageEvent {
  id          String        @id @default(cuid())
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId     String?
  skill       CopilotSkill? @relation(fields: [skillId], references: [id], onDelete: SetNull)
  status      String        @default("STARTED")
  fileCount   Int           @default(0)
  imageCount  Int           @default(0)
  // Legacy estimate fields are retained only for migration compatibility and are no longer used by the admin dashboard.
  promptTokensEstimate     Int           @default(0)
  completionTokensEstimate Int           @default(0)
  totalTokensEstimate      Int           @default(0)
  // Provider-returned figures only. UNAVAILABLE is explicitly not an estimate.
  tokenUsageSource         String        @default("UNAVAILABLE")
  tokenUsageProvider       String?
  tokenUsageModel          String?
  promptTokensActual       Int           @default(0)
  completionTokensActual   Int           @default(0)
  totalTokensActual        Int           @default(0)
  errorCode   String?
  completedAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([courseId, createdAt])
  @@index([userId, courseId, createdAt])
  @@index([skillId, createdAt])
}

model CourseKnowledgeMap {
  id           String             @id @default(cuid())
  courseId     String
  course       Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sourceJobId  String?
  sourceJob    DocumentImportJob? @relation(fields: [sourceJobId], references: [id], onDelete: SetNull)
  title        String
  summary      String?
  status       String             @default("DRAFT")
  version      Int                @default(1)
  publishedAt  DateTime?
  selectionKey String?
  sourceMapIds String?
  textContent  String?
  deletedAt    DateTime?
  nodes        KnowledgeNode[]
  edges        KnowledgeEdge[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([courseId, sourceJobId, version])
  @@unique([courseId, selectionKey, version])
  @@index([sourceJobId, status, version])
  @@index([courseId, selectionKey, status, version])
  @@index([courseId, deletedAt, publishedAt])
}

model KnowledgeNode {
  id            String             @id @default(cuid())
  mapId         String
  map           CourseKnowledgeMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  label         String
  type          String
  summary       String?
  order         Int                @default(0)
  metadata      String?
  outgoingEdges KnowledgeEdge[]    @relation("KnowledgeEdgeSource")
  incomingEdges KnowledgeEdge[]    @relation("KnowledgeEdgeTarget")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model KnowledgeEdge {
  id        String             @id @default(cuid())
  mapId     String
  map       CourseKnowledgeMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  sourceId  String
  source    KnowledgeNode      @relation("KnowledgeEdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId  String
  target    KnowledgeNode      @relation("KnowledgeEdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)
  type      String
  label     String?
  weight    Float?
  metadata  String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  kind      String
  targetId  String
  expiresAt DateTime?
  maxUses   Int?
  usedCount Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model TopicFolder {
  id        String        @id @default(cuid())
  title     String
  parentId  String?
  parent    TopicFolder?  @relation("TopicFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  TopicFolder[] @relation("TopicFolderTree")
  topics    Topic[]
  ownerId   String
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Topic {
  id          String          @id @default(cuid())
  title       String
  description String?
  folderId    String?
  folder      TopicFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  ownerId     String
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status      String          @default("DRAFT")
  sections    TopicSection[]
  resources   TopicResource[]
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model TopicSection {
  id        String   @id @default(cuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title     String
  body      String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TopicResource {
  id          String     @id @default(cuid())
  topicId     String
  topic       Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title       String
  url         String?
  driveFileId String?
  driveFile   DriveFile? @relation(fields: [driveFileId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Message {
  id                  String    @id @default(cuid())
  senderId            String
  sender              User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId          String
  receiver            User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  subject             String
  body                String
  readAt              DateTime?
  archivedAt          DateTime?
  deletedBySenderAt   DateTime?
  deletedByReceiverAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  attachments         MessageAttachment[]
}

model MessageAttachment {
  id          String   @id @default(cuid())
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind        String
  fileName    String
  mimeType    String?
  byteSize    Int      @default(0)
  storagePath String?
  driveFileId String?
  createdAt   DateTime @default(now())

  @@index([messageId, createdAt])
  @@index([driveFileId])
}

model Group {
  id          String        @id @default(cuid())
  name        String
  description String?
  isOpen      Boolean       @default(true)
  members     GroupMember[]
  posts       GroupPost[]
  files       GroupFile[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, userId])
}

model GroupPost {
  id        String         @id @default(cuid())
  groupId   String
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  body      String
  comments  GroupComment[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model GroupComment {
  id        String    @id @default(cuid())
  postId    String
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model GroupFile {
  id          String     @id @default(cuid())
  groupId     String
  group       Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  uploaderId  String
  uploader    User       @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  driveFileId String?
  driveFile   DriveFile? @relation(fields: [driveFileId], references: [id], onDelete: SetNull)
  title       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Note {
  id        String    @id @default(cuid())
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  courseId  String?
  course    Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lessonId  String?
  lesson    Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title     String
  body      String
  tags      NoteTag[]
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model NoteTag {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DriveFile {
  id                      String                    @id @default(cuid())
  ownerId                 String
  owner                   User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parentId                String?
  parent                  DriveFile?                @relation("DriveTree", fields: [parentId], references: [id], onDelete: SetNull)
  children                DriveFile[]               @relation("DriveTree")
  name                    String
  kind                    String
  mimeType                String?
  size                    Int                       @default(0)
  path                    String?
  contentHash             String?
  extractionStatus        String                    @default("PENDING")
  extractedText           String?
  extractionError         String?
  extractedAt             DateTime?
  deletedAt               DateTime?
  shares                  DriveShare[]
  resources               Resource[]
  topicResources          TopicResource[]
  groupFiles              GroupFile[]
  importJobs              DocumentImportJob[]       @relation("ImportSourceDriveFile")
  rootCourse              Course?                   @relation("CourseDriveRoot")
  courseBindings          CourseDriveBinding[]
  courseAccessRules       CourseDriveAccessRule[]
  artifactExports         CourseAiArtifactExport[]
  copilotAttachments      CopilotConversationFile[]
  announcementAttachments AnnouncementAttachment[]
  downloads               DriveFileDownload[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
}

model CourseDriveBinding {
  id        String    @id @default(cuid())
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  purpose   String
  folderId  String
  folder    DriveFile @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([courseId, purpose])
  @@index([folderId])
}

model CourseDriveAccessRule {
  id          String    @id @default(cuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  driveFileId String
  driveFile   DriveFile @relation(fields: [driveFileId], references: [id], onDelete: Cascade)
  access      String
  updatedById String
  updatedBy   User      @relation("CourseDriveAccessRuleUpdater", fields: [updatedById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([courseId, driveFileId])
  @@index([driveFileId])
  @@index([updatedById])
}

model CourseAiArtifactExport {
  id             String           @id @default(cuid())
  artifactId     String
  artifact       CourseAiArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  format         String
  variant        String
  driveFileId    String?
  driveFile      DriveFile?       @relation(fields: [driveFileId], references: [id], onDelete: SetNull)
  contentHash    String?
  status         String           @default("READY")
  errorMessage   String?
  lastExportedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([artifactId, format, variant])
  @@index([driveFileId])
  @@index([status, updatedAt])
}

model DriveShare {
  id          String            @id @default(cuid())
  fileId      String
  file        DriveFile         @relation(fields: [fileId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  code        String            @unique
  expiresAt   DateTime?
  accessCount Int               @default(0)
  grants      DriveShareGrant[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model DriveShareGrant {
  id        String     @id @default(cuid())
  shareId   String
  share     DriveShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([shareId, userId])
  @@index([userId])
}

model PlagiarismCheck {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title        String
  filePath     String?
  status       String   @default("QUEUED")
  similarity   Int      @default(0)
  riskLevel    String?
  reportJson   String?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LiveSession {
  id           String            @id @default(cuid())
  title        String
  description  String?
  hostId       String
  host         User              @relation("LiveHost", fields: [hostId], references: [id], onDelete: Cascade)
  status       String            @default("SCHEDULED")
  startsAt     DateTime?
  endedAt      DateTime?
  participants LiveParticipant[]
  messages     LiveChatMessage[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model LiveParticipant {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime?
  leftAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([sessionId, userId])
}

model LiveChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Announcement {
  id          String                   @id @default(cuid())
  courseId    String
  course      Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId    String
  author      User                     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  body        String
  status      String                   @default("DRAFT")
  publishAt   DateTime?
  pinned      Boolean                  @default(false)
  reads       AnnouncementRead[]
  attachments AnnouncementAttachment[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([courseId, status, publishAt])
}

model AnnouncementAttachment {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  driveFileId    String
  driveFile      DriveFile    @relation(fields: [driveFileId], references: [id], onDelete: Restrict)
  nameSnapshot   String
  createdAt      DateTime     @default(now())

  @@unique([announcementId, driveFileId])
  @@index([driveFileId])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId, readAt])
}

model DriveFileDownload {
  id           String    @id @default(cuid())
  driveFileId  String
  driveFile    DriveFile @relation(fields: [driveFileId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation("DriveFileDownloadUser", fields: [userId], references: [id], onDelete: Cascade)
  downloadedAt DateTime  @default(now())

  @@unique([driveFileId, userId])
  @@index([userId, downloadedAt])
}

model AttendanceSession {
  id          String             @id @default(cuid())
  courseId    String
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User               @relation("AttendanceCreator", fields: [createdById], references: [id], onDelete: Cascade)
  title       String
  status      String             @default("DRAFT")
  startsAt    DateTime?
  endsAt      DateTime?
  records     AttendanceRecord[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([courseId, status, createdAt])
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation("AttendanceStudent", fields: [userId], references: [id], onDelete: Cascade)
  status    String            @default("PRESENT")
  method    String            @default("QR")
  signedAt  DateTime?
  note      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([sessionId, userId])
  @@index([userId, status, updatedAt])
}

model LessonProgress {
  id          String    @id @default(cuid())
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([lessonId, userId])
  @@index([userId, completedAt])
}

model Assignment {
  id                String                 @id @default(cuid())
  courseId          String
  course            Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdById       String
  createdBy         User                   @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  title             String
  instructions      String?
  status            String                 @default("DRAFT")
  publishAt         DateTime?
  dueAt             DateTime?
  allowLate         Boolean                @default(false)
  immediateFeedback Boolean                @default(false)
  sourceArtifactId  String?
  resultPublishedAt DateTime?
  questions         AssignmentQuestion[]
  submissions       AssignmentSubmission[]
  extensions        AssignmentExtension[]
  publishedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([courseId, status, publishAt])
}

model AssignmentQuestion {
  id               String             @id @default(cuid())
  assignmentId     String
  assignment       Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  sourceQuestionId String?
  type             String
  stem             String
  options          String?
  answer           String
  explanation      String
  points           Float              @default(10)
  order            Int
  answers          AssignmentAnswer[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([assignmentId, order])
}

model AssignmentSubmission {
  id           String             @id @default(cuid())
  assignmentId String
  assignment   Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String             @default("DRAFT")
  submittedAt  DateTime?
  score        Float?
  feedback     String?
  gradedAt     DateTime?
  late         Boolean            @default(false)
  answers      AssignmentAnswer[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([assignmentId, userId])
  @@index([userId, status, updatedAt])
}

model AssignmentExtension {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dueAt        DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assignmentId, userId])
  @@index([userId, dueAt])
}

model AssignmentAnswer {
  id           String               @id @default(cuid())
  submissionId String
  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     AssignmentQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response     String               @default("")
  score        Float?
  feedback     String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([submissionId, questionId])
}

model Exam {
  id                String         @id @default(cuid())
  courseId          String
  course            Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdById       String
  createdBy         User           @relation("ExamCreator", fields: [createdById], references: [id], onDelete: Cascade)
  title             String
  instructions      String?
  status            String         @default("DRAFT")
  startsAt          DateTime?
  endsAt            DateTime?
  durationMinutes   Int            @default(60)
  resultPublishedAt DateTime?
  sourceArtifactId  String?
  questions         ExamQuestion[]
  attempts          ExamAttempt[]
  publishedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([courseId, status, startsAt])
}

model ExamQuestion {
  id               String       @id @default(cuid())
  examId           String
  exam             Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  sourceQuestionId String?
  type             String
  stem             String
  options          String?
  answer           String
  explanation      String
  points           Float        @default(10)
  order            Int
  answers          ExamAnswer[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([examId, order])
}

model ExamAttempt {
  id          String       @id @default(cuid())
  examId      String
  exam        Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String       @default("IN_PROGRESS")
  startedAt   DateTime     @default(now())
  submittedAt DateTime?
  score       Float?
  feedback    String?
  gradedAt    DateTime?
  answers     ExamAnswer[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([examId, userId])
  @@index([userId, status, updatedAt])
}

model ExamAnswer {
  id         String       @id @default(cuid())
  attemptId  String
  attempt    ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response   String       @default("")
  score      Float?
  feedback   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([attemptId, questionId])
}

model HelpTicket {
  id        String   @id @default(cuid())
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  body      String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
