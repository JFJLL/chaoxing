{
  "name": "yimei-ai-course-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "clean": "node scripts/clean.mjs",
    "verify": "node scripts/verify.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "smoke": "vitest run tests/unit/courseDriveUi.test.tsx tests/unit/moduleControls.test.tsx tests/unit/aiAppGenerator.test.tsx tests/unit/aiWorkbenchPage.test.tsx",
    "test:data": "vitest run tests/unit/courseAiMigrationIntegrity.test.ts tests/unit/courseAiPublicationConcurrency.test.ts tests/unit/driveDeleteOrdering.test.ts tests/unit/courseCreationRoute.test.ts",
    "eval:ai": "vitest run tests/unit/courseAiGeneration.test.ts tests/unit/courseAiContext.test.ts tests/unit/courseKnowledgeSources.test.ts tests/unit/aiConversation.test.ts tests/unit/courseDriveAdversarial.test.ts",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.8.0",
    "mupdf": "^1.28.0",
    "next": "^15.0.0",
    "openai": "^4.73.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
