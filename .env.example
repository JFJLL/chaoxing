DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-local-dev-secret"
# Zovii 集成（服务端适配器）
ZOVII_API_BASE_URL="https://zovii.studio"
# 32 字节加密密钥（64 位 hex / base64 / 原始字符串），用于加密存储 Zovii refresh token
ZOVII_CREDENTIAL_ENCRYPTION_KEY=""
AI_PROVIDER="gemini"
AI_API_KEY=""
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
AI_MODEL="gemini-3.6-flash"
# 查询翻译专用模型（可选）：留空则 AI 助教中文提问的英译沿用 AI_MODEL。
# 只需设置想覆盖的项；同网关换快模型通常只配 AI_TRANSLATE_MODEL 即可。
AI_TRANSLATE_MODEL=""
AI_TRANSLATE_BASE_URL=""
AI_TRANSLATE_API_KEY=""
AI_TRANSLATE_PROVIDER=""
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4.1-mini"
UPLOAD_DIR="./.uploads"
MAX_FILE_SIZE_MB="50"
MAX_COURSE_UPLOAD_MB="1024"
MAX_INSTITUTION_UPLOAD_MB="10240"
COPILOT_DAILY_LIMIT="100"
IMPORT_STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PREFIX="imports"
DRIVE_STORAGE_PROVIDER="oss"
ALIYUN_OSS_ENDPOINT="https://oss-cn-beijing.aliyuncs.com"
ALIYUN_OSS_BUCKET=""
ALIYUN_OSS_PREFIX="CUC"
ALIYUN_OSS_ACCESS_KEY_ID=""
ALIYUN_OSS_ACCESS_KEY_SECRET=""
IMPORT_QUEUE_PROVIDER="in-process"
PPT_COURSEWARE_TEMPLATE_PATH="./templates/courseware-template.pptx"
